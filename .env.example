# Postgres.app (local, free) — no Docker
DATABASE_URL="postgresql://lara@localhost:5432/productjvity?schema=public"
AI_REVIEW_ENABLED="false"
AI_REVIEW_PROVIDER="gemini"
AI_REVIEW_MODEL="gemini-3.1-flash-lite"
GEMINI_API_KEY=""

# ZeptoMail (primary email provider)
ZEPTO_API_KEY=""
ZEPTO_FROM="Productjvity <hello@yourdomain.com>"

# Cloudflare R2 (private bucket, S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="productjvity-evidence"
# Local offline fallback uses ./uploads/ with the same adapter interface

# App
PORT=3001
JWT_SECRET="change-me"
