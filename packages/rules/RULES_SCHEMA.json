{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://productjvity/rules-schema-v1.json",
  "title": "ProgrammeRules v1 (PRD §10)",
  "type": "object",
  "required": [
    "objective",
    "startsAt",
    "endsAt",
    "measurement",
    "evidenceRequired",
    "successCriteria",
    "failureCriteria",
    "stake",
    "maxForfeiturePct",
    "rewardFormula",
    "breakageSplit",
    "platformFees",
    "exceptions",
    "disputeProcess"
  ],
  "properties": {
    "objective": { "type": "string", "minLength": 1 },
    "startsAt": { "type": "string", "format": "date-time" },
    "endsAt": { "type": "string", "format": "date-time" },
    "measurement": { "type": "string", "minLength": 1 },
    "evidenceRequired": { "type": "array", "items": { "type": "string" } },
    "successCriteria": { "type": "string", "minLength": 1 },
    "failureCriteria": { "type": "string", "minLength": 1 },
    "stake": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 }
      }
    },
    "maxForfeiturePct": { "type": "number", "minimum": 0, "maximum": 100 },
    "rewardFormula": { "type": "string", "minLength": 1 },
    "breakageSplit": {
      "type": "object",
      "required": ["successPct", "platformPct", "institutionPct"],
      "properties": {
        "successPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "platformPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "institutionPct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "platformFees": { "type": "string" },
    "exceptions": { "type": "string" },
    "disputeProcess": { "type": "string", "minLength": 1 }
  }
}
